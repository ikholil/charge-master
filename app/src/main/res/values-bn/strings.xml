    <string name="privacy">গোপনীয়তা</string>
    <string name="privacy_subtitle">চার্জ মাস্টার কী সংরক্ষণ করে এবং কেন</string>
    <string name="privacy_offline_title">নকশাগতভাবে অফলাইন</string>
    <string name="privacy_offline_body">চার্জ মাস্টারের ইন্টারনেট অনুমতি নেই। এতে কোনো অ্যাকাউন্ট, বিজ্ঞাপন, অ্যানালিটিক্স বা ট্র্যাকার নেই।</string>
    <string name="privacy_data_title">কী সংরক্ষণ করা হয়</string>
    <string name="privacy_data_body">ব্যাটারি রিডিং (লেভেল, তাপমাত্রা, ভোল্টেজ, কারেন্ট, চার্জ কাউন্টার, চার্জিং অবস্থা, স্ক্রিন চালু/বন্ধ), চার্জিং সেশন, ক্ষমতার অনুমান এবং আপনার সেটিংস — শুধু এই ডিভাইসে, আপনার নির্বাচিত সময় পর্যন্ত।</string>
    <string name="privacy_permissions_title">অনুমতি</string>
    <string name="privacy_permissions_body">নোটিফিকেশন (আপনার চালু করা সতর্কতার জন্য) এবং স্টার্টআপে চালু হওয়া (রিস্টার্টের পর পর্যবেক্ষণ চালু রাখতে)। কোনো লোকেশন, কন্টাক্ট, এসএমএস, অ্যাক্সেসিবিলিটি বা ওভারলে অনুমতি নেই।</string>
    <string name="privacy_sharing_title">শেয়ার করা</string>
    <string name="privacy_sharing_body">আপনি নিজে অ্যান্ড্রয়েডের শেয়ার শিট দিয়ে ব্যাটারি রিপোর্ট শেয়ার করলেই কেবল তথ্য ডিভাইসের বাইরে যায়।</string>
    <string name="privacy_limits_title">সৎ সীমাবদ্ধতা</string>
    <string name="privacy_limits_body">চার্জ মাস্টার আপনার ব্যাটারি মেরামত, ক্যালিব্রেট বা উন্নত করতে পারে না, চার্জিং নিয়ন্ত্রণ করতে পারে না এবং রুট বা লুকানো সিস্টেম API ব্যবহার করে না। এটি পরিমাপ করে ও ব্যাখ্যা দেয়।</string>
    <string name="onb_1_title">আপনার ব্যাটারি, পরিমাপকৃত</string>
    <string name="onb_1_body">লাইভ লেভেল, তাপমাত্রা, ভোল্টেজ, কারেন্ট ও চার্জিং পাওয়ার — সরাসরি অ্যান্ড্রয়েড থেকে।</string>
    <string name="onb_2_title">নকশাগতভাবে সৎ</string>
    <string name="onb_2_body">প্রতিটি মান লাইভ রিডিং, আনুমানিক বা ইতিহাস হিসেবে চিহ্নিত। আপনার ফোন কিছু না জানালে আমরা অনুমান না করে তা জানিয়ে দিই।</string>
    <string name="onb_3_title">আরও স্মার্ট চার্জিং অভ্যাস</string>
    <string name="onb_3_body">কম ব্যাটারি, চার্জের সীমা ও উচ্চ তাপমাত্রার জন্য ঐচ্ছিক সতর্কতা। এগুলো পেতে নোটিফিকেশনের অনুমতি দিন।</string>
