    <string name="privacy">Privacy</string>
    <string name="privacy_subtitle">What Charge Master stores and why</string>
    <string name="privacy_offline_title">Offline by design</string>
    <string name="privacy_offline_body">Charge Master has no internet permission. It has no accounts, ads, analytics or trackers.</string>
    <string name="privacy_data_title">What is stored</string>
    <string name="privacy_data_body">Battery readings (level, temperature, voltage, current, charge counter, charging status, screen on/off), charging sessions, capacity estimates and your settings — only on this device, for the retention period you choose.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Notifications (for alerts you enable) and run-at-startup (to resume monitoring after a restart). No location, contacts, SMS, accessibility or overlay permissions.</string>
    <string name="privacy_sharing_title">Sharing</string>
    <string name="privacy_sharing_body">Data leaves the device only if you share a battery report yourself through Android\'s share sheet.</string>
    <string name="privacy_limits_title">Honest limits</string>
    <string name="privacy_limits_body">Charge Master cannot repair, calibrate or improve your battery, cannot control charging and does not use root or hidden system APIs. It measures and explains.</string>
    <string name="onb_1_title">Your battery, measured</string>
    <string name="onb_1_body">Live level, temperature, voltage, current and charging power — straight from Android.</string>
    <string name="onb_2_title">Honest by design</string>
    <string name="onb_2_body">Every value is labelled as a live reading, an estimate or history. If your phone does not expose something, we say so instead of guessing.</string>
    <string name="onb_3_title">Smarter charging habits</string>
    <string name="onb_3_body">Optional alerts for low battery, charge thresholds and high temperature. Allow notifications to receive them.</string>
